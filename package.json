{
  "name": "dsh-wetype-voice",
  "version": "0.2.0",
  "description": "Use WeChat Input Method (WeType) dictation instead of the built-in local speech recognition in DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wetype",
    "wechat-input-method",
    "speech-to-text",
    "dictation",
    "windows"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-hint": "echo \"Run install.ps1 from an elevated-free PowerShell to register this bundle into a DSH profile.\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ]
}
